	(text "Switch inputs (no optocoupler): switch to +battery at J5 pins 1-4.\nTVS SMAJ30CA, 4.7k load (contact wetting), 10k series, 4.7k/3.3V Zener divider, 100nF filter.\nNode SWn: ~3.2 V for any input 10.5-30 V, EN threshold ~7.5 V at the switch, tau ~0.3 ms.\nWorks without the 3.3 V rail: SWn drives the output EN via the diode-OR on the root sheet."
		(exclude_from_sim no)
		(at 165.1 25.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "188fae58-d0b5-4322-b066-17c71f9e3127")
	)
